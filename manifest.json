{
  "manifest_version": 3,
  "name": "XERXES // SPINE HUD",
  "version": "1.1",
  "description": "Premium real-time spine vector tracking HUD",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["overlay.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "tabs"
  ]
}