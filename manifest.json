{
  "manifest_version": 3,
  "name": "Xerxes Posture Monitor",
  "version": "2.0.0",
  "description": "Desk posture alerts that reach you in any tab. Works with the Xerxes dashboard. No data leaves your machine.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Xerxes",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://xerxes.bitbuzz.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "notifications",
    "storage",
    "alarms",
    "scripting"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
